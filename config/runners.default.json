{
  "version": 1,
  "runners": {
    "codex-cli": {
      "description": "Codex CLI non-interactive worker",
      "command": "codex",
      "args": [
        "exec",
        "--cd",
        "{cwd}",
        "--sandbox",
        "workspace-write",
        "-c",
        "approval_policy=\"never\"",
        "-c",
        "web_search=\"disabled\"",
        "--color",
        "never",
        "--output-last-message",
        "{output_file}",
        "{prompt}"
      ],
      "webDisableArgs": [
        "-c",
        "web_search=\"disabled\""
      ],
      "prompt": "argument",
      "result": "output-file",
      "stream": "text"
    },
    "claude-cli": {
      "description": "Claude Code non-interactive worker",
      "command": "claude",
      "args": [
        "--print",
        "--disallowedTools",
        "WebFetch",
        "WebSearch",
        "--output-format",
        "text",
        "--permission-mode",
        "acceptEdits",
        "{prompt}"
      ],
      "webDisableArgs": [
        "--disallowedTools",
        "WebFetch",
        "WebSearch"
      ],
      "prompt": "argument",
      "result": "stdout",
      "stream": "text"
    },
    "grok-cli": {
      "description": "Grok CLI non-interactive worker",
      "command": "grok",
      "args": [
        "--cwd",
        "{cwd}",
        "--permission-mode",
        "auto",
        "--output-format",
        "streaming-messages-json",
        "--include-partial-messages",
        "--verbatim",
        "--disable-web-search",
        "--single",
        "{prompt}"
      ],
      "webDisableArgs": [
        "--disable-web-search"
      ],
      "prompt": "argument",
      "result": "stdout",
      "stream": "messages-json",
      "defaultHierarchyDepth": 1
    }
  }
}
